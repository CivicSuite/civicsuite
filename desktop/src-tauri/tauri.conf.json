{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CivicSuite",
  "version": "0.1.0",
  "identifier": "org.civicsuite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CivicSuite",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CivicSuite",
    "licenseFile": "../installer/windows/unsigned-beta-install-notice.txt",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "../installer/windows/nsis-hooks.nsh",
        "languages": ["English"],
        "startMenuFolder": "CivicSuite"
      }
    }
  }
}
