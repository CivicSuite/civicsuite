graph TB
    subgraph SUITE["GitHub: CivicSuite organization"]
        SuiteRepo["civicsuite<br/>umbrella repo<br/>governance, compatibility matrix,<br/>spec docs, ADRs"]
        Core["civiccore<br/>v0.2.0 shared library<br/>migrations + db.Base + llm"]
    end
    subgraph PRODUCT["GitHub: CivicSuite organization"]
        Records["civicrecords-ai<br/>v1.4.0<br/>FOIA / public records app"]
    end
    subgraph FUTURE["Future modules — planned, not started"]
        Clerk["civicclerk<br/>meeting management"]
        Zone["civiczone<br/>zoning / land use"]
    end
    SuiteRepo -.documents.-> Core
    SuiteRepo -.documents.-> Records
    SuiteRepo -.governs.-> Clerk
    SuiteRepo -.governs.-> Zone
    Records -->|"depends on ==0.2.0"| Core
    Clerk -. "future ==X.Y" .-> Core
    Zone -. "future ==X.Y" .-> Core
    classDef shipping fill:#d4f4dd,stroke:#3a7a4a,stroke-width:2px,color:#000
    classDef governance fill:#e1e1ff,stroke:#5a5aa0,stroke-width:2px,color:#000
    classDef future fill:#fff4e1,stroke:#a08040,stroke-width:1px,stroke-dasharray:5 5,color:#000
    class SuiteRepo governance
    class Core shipping
    class Records shipping
    class Clerk future
    class Zone future
